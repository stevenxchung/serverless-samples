{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": "./dist",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "types": ["bun-types"],
    "paths": {
      "@constants/*": ["src/constants/*"],
      "@db/*": ["src/db/*"],
      "@models/*": ["src/models/*"],
      "@repository/*": ["src/repository/*"],
      "@routes/*": ["src/routes/*"],
      "@services/*": ["src/services/*"],
      "@types/*": ["types/*"]
    }
  },
  "include": ["src/**/*.ts", "sqlite/**/*.ts", "types/**/*.ts"]
}
